// NurtureTrack V3 Firestore rules.
// users: private to the owner. households: members only. invites: any signed in
// user can read a code, only the creator can write it once.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /households/{householdId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 1;

      // Joining: only memberIds changes, old ids are kept, exactly the caller is added,
      // and the household's invitation code must exist.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && exists(/databases/$(database)/documents/invites/$(resource.data.inviteCode));

      match /members/{memberId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
        // Rules see the pre-batch state, so a joiner is allowed when the household's invite
        // exists. getAfter covers the creator, whose household is written in the same batch.
        allow create: if signedIn()
          && request.auth.uid == memberId
          && (
            request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds
            || exists(/databases/$(database)/documents/invites/$(get(/databases/$(database)/documents/households/$(householdId)).data.inviteCode))
            || request.auth.uid in getAfter(/databases/$(database)/documents/households/$(householdId)).data.memberIds
          );
      }
    }

    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
