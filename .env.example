# NurtureTrack environment variables.
#
# Copy this file to `.env` and fill in the real values. `.env` is git ignored, so the keys
# stay out of the repository.
#
# Note for the group: src/api/firebase.js still has the Firebase web config inline, because
# that file belongs to V2 and App must not change it. These keys are the ones to move it over
# to, and the server functions read the same project. A Firebase web config is not a secret
# (it ships in the browser bundle), but the key below is restricted in the Google console.

VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Needed later, for web push. Firebase console, Project settings, Cloud Messaging, Web Push
# certificates. Nothing reads it yet: the notification preferences in Settings are saved but
# no token is registered until the push server is built.
VITE_FIREBASE_VAPID_KEY=your-web-push-public-key

# Google Calendar without a server. OAuth 2.0 Web client ID (ends in
# .apps.googleusercontent.com), public by design, so it is safe in the browser bundle. When it
# is set, Settings talks to Google Calendar straight from the browser and hides the server
# controls. docs/google-calendar-client.md has the Google Cloud steps. Leave it empty or as a
# placeholder to keep the Vercel based flow.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# ---------------------------------------------------------------------------
# Server only, from here down. These belong in Vercel, Project settings,
# Environment variables, and nowhere else: they are not VITE_ prefixed on
# purpose, so Vite can never put them in the browser bundle. Never commit the
# real values, and never read them from anything under src/.
# docs/setup.md says where each one comes from.
# ---------------------------------------------------------------------------

# Firebase service account (Firebase console, Project settings, Service accounts,
# Generate new private key). FIREBASE_PRIVATE_KEY is the whole key from that JSON
# file, including the BEGIN and END lines, pasted as one line with literal \n
# where the newlines were. The server puts the newlines back.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Google Calendar OAuth (Google Cloud console, APIs and services, Credentials,
# OAuth 2.0 Client ID of type Web application). The redirect URI must match the
# one registered there exactly, including the scheme and any port.
#   local:      http://localhost:3000/api/google/callback
#   production: https://your-app.vercel.app/api/google/callback
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Signs the short lived OAuth state value, so the uid that comes back from Google
# cannot be swapped for somebody else's. Any long random string will do:
#   openssl rand -base64 48
OAUTH_STATE_SECRET=a-long-random-string-of-your-own

# Where the Google callback sends the browser afterwards. No trailing slash.
#   local:      http://localhost:3000
#   production: https://your-app.vercel.app
APP_URL=http://localhost:3000
