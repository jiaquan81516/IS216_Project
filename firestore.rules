rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserData(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    function isCareGroupMember(careGroupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/careGroups/$(careGroupId))
        && request.auth.uid in get(/databases/$(database)/documents/careGroups/$(careGroupId)).data.memberIds;
    }

    function canAccessBaby(babyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/babies/$(babyId))
        && isCareGroupMember(get(/databases/$(database)/documents/babies/$(babyId)).data.careGroupId);
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
    }

    match /careGroups/{careGroupId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow read, delete: if isCareGroupMember(careGroupId);
      allow update: if isCareGroupMember(careGroupId)
        && request.auth.uid in request.resource.data.memberIds;
    }

    match /babies/{babyId} {
      allow create: if isCareGroupMember(request.resource.data.careGroupId);
      allow read, delete: if canAccessBaby(babyId);
      allow update: if canAccessBaby(babyId)
        && isCareGroupMember(request.resource.data.careGroupId);
    }

    match /feedings/{feedingId} {
      allow create: if canAccessBaby(request.resource.data.babyId);
      allow read, delete: if canAccessBaby(resource.data.babyId);
      allow update: if canAccessBaby(resource.data.babyId)
        && canAccessBaby(request.resource.data.babyId);
    }

    match /wellnessCheckIns/{checkInId} {
      allow create: if ownsUserData(request.resource.data);
      allow read, delete: if ownsUserData(resource.data);
      allow update: if ownsUserData(resource.data) && ownsUserData(request.resource.data);
    }

    match /journalEntries/{entryId} {
      allow create: if ownsUserData(request.resource.data);
      allow read, delete: if ownsUserData(resource.data);
      allow update: if ownsUserData(resource.data) && ownsUserData(request.resource.data);
    }

    match /resources/{resourceId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
