// NurtureTrack App Firestore rules.
// users: private to the owner. households: members only. invites: any signed in
// user can read a code, only the creator can write it once.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isParentFor(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid))
        && (get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.get('accessLevel', '') == 'parent'
          || get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.get('role', '') in ['mum', 'dad', 'carer', 'parent', 'partner']);
    }

    function isCreatorOfNewHousehold(householdId) {
      return signedIn()
        && existsAfter(/databases/$(database)/documents/households/$(householdId))
        && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(householdId)).data.memberIds
        && existsAfter(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/households/$(householdId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.accessLevel == 'parent';
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /households/{householdId} {
      function memberPath(uid) {
        return /databases/$(database)/documents/households/$(householdId)/members/$(uid);
      }

      function isMember() {
        return signedIn() && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
      }

      function isPrimaryParent() {
        return isMember()
          && exists(memberPath(request.auth.uid))
          && (get(memberPath(request.auth.uid)).data.get('accessLevel', '') == 'parent'
          || get(memberPath(request.auth.uid)).data.get('role', '') in ['mum', 'dad', 'carer', 'parent', 'partner']);
      }

      function isPrimaryMember(data) {
        return data.get('accessLevel', '') == 'parent'
          || data.get('role', '') in ['mum', 'dad', 'carer', 'parent', 'partner'];
      }

      function hasPermission(key) {
        return isPrimaryParent()
          || (isMember()
            && exists(memberPath(request.auth.uid))
            && get(memberPath(request.auth.uid)).data.get('permissions', {}).get(key, false) == true);
      }

      allow read: if isPrimaryParent();

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 1;

      // Joining: only memberIds changes, old ids are kept, exactly the caller is added,
      // and the household's invitation code must exist.
      // Leaving: a member may take themselves out. A parent may also remove a caregiver.
      // Editing: a parent may change the baby details and the invitation code, with the
      // baby name capped so one person cannot push a huge string into a shared document.
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && !(request.auth.uid in resource.data.memberIds)
          && existsAfter(memberPath(request.auth.uid))
          && getAfter(memberPath(request.auth.uid)).data.inviteCode is string
          && exists(/databases/$(database)/documents/invites/$(getAfter(memberPath(request.auth.uid)).data.inviteCode))
          && get(/databases/$(database)/documents/invites/$(getAfter(memberPath(request.auth.uid)).data.inviteCode)).data.householdId == householdId
          && get(/databases/$(database)/documents/invites/$(getAfter(memberPath(request.auth.uid)).data.inviteCode)).data.usedBy == null
          && get(/databases/$(database)/documents/invites/$(getAfter(memberPath(request.auth.uid)).data.inviteCode)).data.revokedAt == null
          && (!('expiresAt' in get(/databases/$(database)/documents/invites/$(getAfter(memberPath(request.auth.uid)).data.inviteCode)).data)
            || get(/databases/$(database)/documents/invites/$(getAfter(memberPath(request.auth.uid)).data.inviteCode)).data.expiresAt > request.time))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && ((request.auth.uid in resource.data.memberIds && !(request.auth.uid in request.resource.data.memberIds))
            || isPrimaryParent()))
        || (isPrimaryParent()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['babyName', 'babyStatus', 'babyDate', 'inviteCode'])
          && (!('babyName' in request.resource.data) || request.resource.data.babyName == null
            || (request.resource.data.babyName is string && request.resource.data.babyName.size() <= 80)))
      );

      match /members/{memberId} {
        allow read: if isPrimaryParent() || request.auth.uid == memberId;

        allow create: if signedIn()
          && request.auth.uid == memberId
          && (
            (request.resource.data.accessLevel == 'parent'
              && getAfter(/databases/$(database)/documents/households/$(householdId)).data.createdBy == request.auth.uid
              && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(householdId)).data.memberIds)
            || (request.resource.data.inviteCode is string
              && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.householdId == householdId
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedBy == null
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.revokedAt == null
              && (!('expiresAt' in get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data)
                || get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time)
              && ((get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.get('kind', 'parent') == 'caregiver'
                    && request.resource.data.accessLevel == 'caregiver'
                    && request.resource.data.role == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.caregiverRole
                    && request.resource.data.permissions == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.permissions)
                || (get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.get('kind', 'parent') == 'parent'
                    && request.resource.data.accessLevel == 'parent')))
          );

        allow update: if (request.auth.uid == memberId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'role'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isPrimaryMember(resource.data))
            && (!('displayName' in request.resource.data) || request.resource.data.displayName == null
              || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80)))
          || (isPrimaryParent()
            && !isPrimaryMember(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'accessLevel', 'permissions'])
            && request.resource.data.accessLevel == 'caregiver'
            && request.resource.data.role in ['grandparent', 'domestic-helper', 'babysitter', 'childcare-provider', 'trusted-caregiver']
            && request.resource.data.permissions is map
            && request.resource.data.permissions.keys().hasOnly(['careBrief', 'careLogRead', 'careLogAdd', 'careLogEdit', 'careLogMedication', 'feedingInstructions', 'allergyInfo', 'medicationInfo', 'appointments', 'napRoutine']));
        allow delete: if (signedIn() && request.auth.uid == memberId)
          || (isPrimaryParent() && !isPrimaryMember(resource.data));
      }

      match /careBrief/{sectionId} {
        allow read: if (sectionId == 'routine' && hasPermission('napRoutine'))
          || (sectionId == 'feeding' && hasPermission('feedingInstructions'))
          || ((sectionId == 'contacts' || sectionId == 'child') && hasPermission('careBrief'))
          || (sectionId == 'allergies' && hasPermission('allergyInfo'))
          || (sectionId == 'medications' && hasPermission('medicationInfo'));
        allow create, update: if isPrimaryParent()
          && ((sectionId == 'routine'
              && request.resource.data.keys().hasOnly(['napRoutine'])
              && request.resource.data.napRoutine is string && request.resource.data.napRoutine.size() <= 500)
            || (sectionId == 'feeding'
              && request.resource.data.keys().hasOnly(['feeding'])
              && request.resource.data.feeding is string && request.resource.data.feeding.size() <= 500)
            || (sectionId == 'contacts'
              && request.resource.data.keys().hasOnly(['parentContacts'])
              && request.resource.data.parentContacts is string && request.resource.data.parentContacts.size() <= 500)
            || (sectionId == 'child'
              && request.resource.data.keys().hasOnly(['babyName'])
              && request.resource.data.babyName is string && request.resource.data.babyName.size() <= 80)
            || (sectionId == 'allergies'
              && request.resource.data.keys().hasOnly(['allergies'])
              && request.resource.data.allergies is string && request.resource.data.allergies.size() <= 500)
            || (sectionId == 'medications'
              && request.resource.data.keys().hasOnly(['medications'])
              && request.resource.data.medications is string && request.resource.data.medications.size() <= 500));
        allow delete: if false;
      }

      // Babies. One document per extra baby in the household (the first baby stays on the
      // household document). Parents read and write them, in the same shape the household
      // document uses for its own baby. Nothing is deleted.
      match /babies/{babyId} {
        allow read: if isPrimaryParent();
        allow create, update: if isPrimaryParent()
          && request.resource.data.keys().hasOnly(['babyName', 'babyStatus', 'babyDate', 'createdAt'])
          && (request.resource.data.babyName == null
            || (request.resource.data.babyName is string && request.resource.data.babyName.size() <= 80))
          && request.resource.data.babyStatus in ['expected', 'born']
          && (request.resource.data.babyDate == null
            || (request.resource.data.babyDate is string && request.resource.data.babyDate.size() == 10));
        allow delete: if false;
      }

      // The care log. Members read. Anyone can add their own entries. Only the author edits
      // or deletes an entry, except that any member may add or change their own key in seenBy.
      match /entries/{entryId} {
        function isMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
        }
        function validEntry() {
          return request.resource.data.type in ['feed', 'sleep', 'nappy', 'medication', 'note']
            && request.resource.data.at is timestamp
            // A note is user supplied text, so it is capped the same way everywhere else.
            && (!('details' in request.resource.data)
              || !('text' in request.resource.data.details)
              || request.resource.data.details.text == null
              || (request.resource.data.details.text is string
                && request.resource.data.details.text.size() <= 400));
        }

        allow read: if hasPermission('careLogRead');

        allow create: if hasPermission('careLogAdd')
          && (request.resource.data.type != 'medication' || hasPermission('careLogMedication'))
          && request.resource.data.by == request.auth.uid
          && validEntry();

        allow update: if isMember() && (
          (hasPermission('careLogEdit')
            && (resource.data.type != 'medication' || hasPermission('careLogMedication'))
            && resource.data.by == request.auth.uid
            && request.resource.data.by == resource.data.by
            && validEntry())
          || (hasPermission('careLogRead') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
            && request.resource.data.seenBy.diff(resource.data.seenBy).affectedKeys().hasOnly([request.auth.uid]))
        );

        allow delete: if hasPermission('careLogEdit') && resource.data.by == request.auth.uid;
      }

      // Shared membership check for the collections below. The care log keeps its own copy
      // so that rule stays exactly as it was.
      function sharedMember() {
        return signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
      }

      // The sleep rota plan. One document, "settings". Either parent may save it, and every
      // write says who did it.
      match /rota/{docId} {
        allow read: if isPrimaryParent();
        allow create, update: if isPrimaryParent() && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }

      // One document per night, id yyyy-mm-dd, for nights set by hand or by an accepted swap.
      match /nights/{nightId} {
        allow read: if isPrimaryParent();
        allow create, update: if isPrimaryParent() && request.resource.data.setBy == request.auth.uid;
        allow delete: if isPrimaryParent();
      }

      // Swap requests. You may only ask in your own name, only the other parent may accept or
      // decline, and only the asker may cancel.
      match /swaps/{swapId} {
        allow read: if isPrimaryParent();

        allow create: if isPrimaryParent()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.status == 'pending';

        allow update: if isPrimaryParent()
          && request.resource.data.from == resource.data.from
          && request.resource.data.date == resource.data.date
          && resource.data.status == 'pending'
          && (
            (resource.data.to == request.auth.uid
              && request.resource.data.status in ['accepted', 'declined'])
            || (resource.data.from == request.auth.uid
              && request.resource.data.status == 'cancelled')
          );

        allow delete: if false;
      }

      // Calendar events. Shared, so either parent may edit or delete one. The author is kept.
      match /events/{eventId} {
        allow read: if hasPermission('appointments');
        allow create: if isPrimaryParent() && request.resource.data.createdBy == request.auth.uid;
        allow update: if isPrimaryParent() && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isPrimaryParent();
      }

      // Return to work tasks. Shared the same way as events.
      match /tasks/{taskId} {
        allow read: if isPrimaryParent();
        allow create: if isPrimaryParent() && request.resource.data.createdBy == request.auth.uid;
        allow update: if isPrimaryParent() && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isPrimaryParent();
      }

      // The household stream's plain messages. Members read. You may only post in your own
      // name, with 1 to 500 characters, stamped by the server clock and not yet acknowledged.
      // Only a member who is not the author may acknowledge, and that write adds their own
      // uid to ackedBy and sets ackedAt, nothing else. Only the author may delete.
      // Feelings. One optional word per person ("hard", "okay" or "good") that the person chose to
      // share with their partner. Members read it; only its owner writes or removes it. The
      // private check-in itself is never stored here.
      match /feelings/{feelingId} {
        allow read: if hasPermission('wellness');
        allow create, update: if isPrimaryParent()
          && feelingId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'level', 'date', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.level in ['hard', 'okay', 'good']
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10
          && request.resource.data.updatedAt == request.time;
        allow delete: if isPrimaryParent() && feelingId == request.auth.uid;
      }

      // The family photo on Home. One document, "frame", shrunk to a small JPEG in the browser
      // (under 400 KB as text) so it stays well inside the 1 MB document limit. Both parents read,
      // add, change or remove it, and every write names who made it.
      match /photo/{docId} {
        allow read: if sharedMember();
        allow create, update: if sharedMember()
          && docId == 'frame'
          && request.resource.data.keys().hasOnly(['image', 'caption', 'updatedBy', 'updatedAt'])
          && request.resource.data.image is string
          && request.resource.data.image.size() < 400000
          && request.resource.data.caption is string
          && request.resource.data.caption.size() <= 40
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if sharedMember() && docId == 'frame';
      }

      // Wellness check-ins. Both parents read them, so the week can be shown as a pair. One
      // document per person per day, named uid_yyyy-mm-dd, and only its owner writes it.
      match /checkins/{checkinId} {
        allow read: if sharedMember();
        allow create, update: if sharedMember()
          && request.resource.data.keys().hasOnly(['uid', 'date', 'mood', 'stress', 'energy', 'closeness', 'concerns', 'body', 'lifts', 'savedAt', 'moodStage', 'need', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10
          && checkinId == request.auth.uid + '_' + request.resource.data.date
          && request.resource.data.mood is int && request.resource.data.mood >= 1 && request.resource.data.mood <= 5
          && request.resource.data.stress is int && request.resource.data.stress >= 1 && request.resource.data.stress <= 5
          && request.resource.data.concerns is list && request.resource.data.concerns.size() <= 3
          && request.resource.data.body is list && request.resource.data.body.size() <= 8
          && request.resource.data.lifts is list && request.resource.data.lifts.size() <= 8
          && request.resource.data.savedAt is string
          && request.resource.data.moodStage in ['budding', 'opening', 'bloom', 'drooping', 'wilted']
          && request.resource.data.need in ['coverTonight', 'checkOnMe', 'giveSpace']
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // The chat between the two parents. Written in your own name, once, and never edited or
      // deleted. "thanks" marks a thank you so the weekly summary can count it.
      match /chat/{messageId} {
        allow read: if isPrimaryParent();
        allow create: if isPrimaryParent()
          && request.resource.data.keys().hasOnly(['from', 'text', 'kind', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 200
          && request.resource.data.kind in ['text', 'thanks']
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /posts/{postId} {
        allow read: if isPrimaryParent();

        allow create: if isPrimaryParent()
          && request.resource.data.keys().hasOnly(['text', 'authorUid', 'createdAt', 'ackedBy'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && (!('ackedBy' in request.resource.data) || request.resource.data.ackedBy == []);

        allow update: if isPrimaryParent()
          && resource.data.authorUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackedBy', 'ackedAt'])
          && !(request.auth.uid in resource.data.get('ackedBy', []))
          && request.resource.data.ackedBy == resource.data.get('ackedBy', []).concat([request.auth.uid])
          && request.resource.data.ackedAt == request.time;

        allow delete: if isPrimaryParent() && resource.data.authorUid == request.auth.uid;
      }

      // The return to work plan. One document, "plan", like the rota settings.
      match /rtw/{docId} {
        allow read: if isPrimaryParent();
        allow create, update: if isPrimaryParent() && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
    }

    // Invitation codes. Any signed in user can read a code to join with it. An invite is
    // never deleted: it is marked used when somebody joins with it, and revoked when the
    // household makes a new code, so an old code gets a clear answer instead of "not found".
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (isParentFor(request.resource.data.householdId)
          || isCreatorOfNewHousehold(request.resource.data.householdId))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedAt == null
        && request.resource.data.usedBy == null
        && request.resource.data.kind in ['parent', 'caregiver']
        && (request.resource.data.kind != 'caregiver'
          || (request.resource.data.caregiverRole in ['grandparent', 'domestic-helper', 'babysitter', 'childcare-provider', 'trusted-caregiver']
            && request.resource.data.permissions is map
            && request.resource.data.permissions.keys().hasOnly(['careBrief', 'careLogRead', 'careLogAdd', 'careLogEdit', 'careLogMedication', 'feedingInstructions', 'allergyInfo', 'medicationInfo', 'appointments', 'napRoutine'])
            && request.resource.data.caregiverName is string
            && request.resource.data.caregiverName.size() <= 40));

      allow update: if signedIn() && (
        // Joining with it: only the two "used" fields, only once, in your own name.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt', 'usedBy'])
          && resource.data.usedBy == null
          && resource.data.revokedAt == null
          && (!('expiresAt' in resource.data) || resource.data.expiresAt > request.time)
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.usedAt is timestamp
          && existsAfter(/databases/$(database)/documents/households/$(resource.data.householdId)/members/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/households/$(resource.data.householdId)/members/$(request.auth.uid)).data.inviteCode == code
          && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(resource.data.householdId)).data.memberIds)
        // Replacing it: only the creator, and only the revoked stamp.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt'])
          && (resource.data.createdBy == request.auth.uid || isParentFor(resource.data.householdId))
          && request.resource.data.revokedAt is timestamp)
      );

      allow delete: if false;
    }

    // Server only collections. Nothing in the browser may read or write these, and nothing
    // needs to: the Vercel functions use the Firebase Admin SDK, which is not bound by these
    // rules at all. Denying them here is what keeps a Google refresh token, a rate limit
    // counter and an OAuth nonce out of reach of the client.
    //
    // googleTokens/{uid}  the Google refresh token, its scope and the NurtureTrack calendar id
    // googleSync/{uid}    the calendar sync token and the map of what was pushed to Google,
    //                     which is how a deleted event is noticed without a tombstone
    // oauthStates/{nonce} the one time nonce in the OAuth state value
    // serverLimits/{uid}  the per uid sliding window behind the 429 answers
    match /googleTokens/{uid} {
      allow read, write: if false;
    }
    match /googleSync/{uid} {
      allow read, write: if false;
    }
    match /oauthStates/{nonce} {
      allow read, write: if false;
    }
    match /serverLimits/{uid} {
      allow read, write: if false;
    }

    // The pumping room directory. Global on purpose: a nursing room at a mall is the same
    // room for every household. Any signed in user reads it, adds one, and confirms or flags
    // one. Nothing is deleted, so a bad edit can always be traced through the reports.
    //
    // Rate limiting: rules cannot count writes over time, so the real limit belongs on the
    // server (docs/data-model.md, section 7). What rules can do is make every write
    // attributable and bounded, which is what the time and length checks below are for.
    match /pumpingRooms/{roomId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 200
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 200
        && request.resource.data.placeId is string
        && request.resource.data.placeId.size() > 0
        && request.resource.data.placeId.size() <= 200
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.createdAt == request.time;

      // Only the verification state moves, and only ever through a report.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifiedAt'])
        && request.resource.data.status in ['verified', 'unverified'];

      allow delete: if false;

      match /reports/{reportId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.field is string
          && request.resource.data.field.size() <= 40
          && request.resource.data.value is string
          && request.resource.data.value.size() <= 400;
        allow update, delete: if false;
      }
    }
  }
}
